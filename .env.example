# ── API server ────────────────────────────────────────────────────────────────

# TCP port the Express server listens on.
PORT=3001

# Origin of the React frontend — used for CORS allow-list.
# In Docker Compose local dev: http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Node environment. Use "development" locally, "production" in deploy.
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────

# Full MongoDB connection string.  The replica-set name must match
# the value used in docker-compose.yml (rs0).
# In Docker Compose local dev: mongodb://mongo:27017/student_club?replicaSet=rs0
MONGO_URI=mongodb://localhost:27017/student_club?replicaSet=rs0

# ── Redis ─────────────────────────────────────────────────────────────────────

# Full Redis connection URL.
# In Docker Compose local dev: redis://redis:6379
REDIS_URL=redis://localhost:6379

# ── Authentication ────────────────────────────────────────────────────────────

# Secret used to sign JWTs. Must be at least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# How long JWTs remain valid. Examples: 15m, 1h, 7d.
JWT_EXPIRES_IN=7d

# Optional: secret to sign cookies. Must be ≥ 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# COOKIE_SECRET=replace_with_another_long_random_string

# ── Club configuration ────────────────────────────────────────────────────────

# The MongoDB ObjectId of the single club document (Phase 1 single-club mode).
# Generate once: node -e "console.log(require('mongodb').ObjectId().toHexString())"
# Then run npm run seed:memberships to create the club + default tier.
# Defaults to '000000000000000000000001' for local dev if not set.
CLUB_ID=000000000000000000000001

# ── Dev seed variables (NEVER set in production) ──────────────────────────────

# Used by: npx tsx apps/server/src/scripts/seed-admin.ts
# SEED_ADMIN_EMAIL=admin@yourclub.example
# SEED_ADMIN_PASSWORD=AtLeast8Chars!
# SEED_ADMIN_NAME=Club Admin

# ── Frontend ──────────────────────────────────────────────────────────────────

# Base URL the React app uses to reach the API.
# In Docker Compose local dev Vite proxy handles /api, so this can be empty.
# In production set to the public API URL: https://api.yourclub.example.com
VITE_API_BASE_URL=
